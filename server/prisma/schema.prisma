generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  phone         String?
  email         String?
  whatsapp      String?
  primaryColor  String    @default("#6C63FF")
  planType      String    @default("FREE")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         String    @default("CLIENT")
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}

model Client {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  phone        String
  whatsapp     String?
  email        String?
  isVip        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("clients")
}

model Barber {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  specialties     String
  phone           String?
  email           String?
  workingDays     String    @default("[1,2,3,4,5,6]")
  startTime       String    @default("08:00")
  endTime         String    @default("18:00")
  commissionPercent Float   @default(40)
  color           String    @default("#6C63FF")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("barbers")
}

model Service {
  id                String    @id @default(uuid())
  tenantId          String
  name              String
  description       String?
  price             Float
  duration          Int
  color             String    @default("#6C63FF")
  category          String?
  commissionPercent Float     @default(40)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("services")
}

model Appointment {
  id            String    @id @default(uuid())
  tenantId      String
  clientId      String
  barberId      String
  date          DateTime
  startTime     String
  endTime       String
  totalValue    Float     @default(0)
  status        String    @default("SCHEDULED")
  notes         String?
  isOnlineBooking Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("appointments")
}

model Rating {
  id            String    @id @default(uuid())
  tenantId      String
  clientId      String
  appointmentId String?
  barberId      String?
  rating        Int
  comment       String?
  createdAt     DateTime  @default(now())

  @@map("ratings")
}

model Expense {
  id          String    @id @default(uuid())
  tenantId    String
  description String
  amount      Float
  category    String?
  date        DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("expenses")
}

model Cashier {
  id          String    @id @default(uuid())
  tenantId    String
  type        String
  amount      Float
  description String
  paymentMethod String?
  appointmentId String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@map("cashier")
}